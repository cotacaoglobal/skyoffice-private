# ========================================================
# Configurações do Cliente SkyOffice (Front-end Vite/React)
# ========================================================

# URL do servidor Colyseus (opcional)
# Se não for definida, o cliente detecta automaticamente o host atual
# Exemplo para produção com domínio próprio:
# VITE_SERVER_URL=wss://app.seusite.com/colyseus
# Exemplo para desenvolvimento local:
# VITE_SERVER_URL=ws://localhost:2567
VITE_SERVER_URL=
